.wrap { max-width: 760px; margin: 0 auto; padding: 28px 20px 60px; }
.header { text-align: center; margin-bottom: 22px; }
.logo {
  width: 54px; height: 54px; border-radius: 16px; margin: 0 auto 10px;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 22px; color: #fff; box-shadow: 0 8px 30px rgba(124,58,237,.45);
}
.header h1 { margin: 0; font-size: 28px; letter-spacing: .3px; }
.header p { margin: 4px 0 0; color: #9aa3bd; font-size: 14px; }

.card {
  background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
  border-radius: 18px; padding: 20px; margin-bottom: 16px;
  backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(0,0,0,.25);
}
.card h3 { margin: 0 0 12px; font-size: 13px; text-transform: uppercase; letter-spacing: 1.2px; color: #9aa3bd; font-weight: 600; }

.btn-main {
  width: 100%; padding: 13px; border: 0; border-radius: 12px; cursor: pointer;
  font-size: 15px; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, #7c3aed, #06b6d4); transition: transform .15s, box-shadow .15s;
}
.btn-main:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(6,182,212,.35); }
.btn-main:disabled { opacity: .6; cursor: wait; transform: none; }

.login-msg { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; background: rgba(6,182,212,.12); color: #7ee7ff; font-size: 14px; }
.small { display: block; margin: 14px 0 8px; color: #9aa3bd; font-size: 12px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  display: flex; align-items: center; gap: 8px; padding: 7px 12px 7px 7px; cursor: pointer;
  border-radius: 999px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.05);
  color: #e9ecf5; font-size: 13px; text-transform: capitalize; transition: background .15s;
}
.chip:hover { background: rgba(255,255,255,.12); }
.dot {
  width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 12px; color: #fff; text-transform: uppercase;
}

textarea {
  width: 100%; min-height: 130px; resize: vertical; padding: 14px; border-radius: 12px;
  border: 1px solid rgba(255,255,255,.14); background: rgba(0,0,0,.25); color: #fff;
  font-size: 15px; font-family: inherit; outline: none;
}
textarea:focus { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,.25); }
.count { text-align: right; font-size: 12px; color: #7d86a3; margin-top: 4px; }

.drop {
  display: flex; align-items: center; gap: 14px; padding: 14px; cursor: pointer; margin-top: 12px;
  border: 2px dashed rgba(255,255,255,.2); border-radius: 12px; background: rgba(255,255,255,.03);
  transition: border-color .15s, background .15s;
}
.drop:hover { border-color: #06b6d4; background: rgba(6,182,212,.06); }
.drop .plus {
  width: 42px; height: 42px; border-radius: 12px; background: rgba(6,182,212,.18);
  display: flex; align-items: center; justify-content: center; font-size: 24px; color: #7ee7ff; flex-shrink: 0;
}
.drop b { display: block; font-size: 14px; }
.drop span { font-size: 12px; color: #9aa3bd; word-break: break-all; }
.drop .x { margin-left: auto; background: rgba(255,80,80,.18); color: #ff8a8a; border: 0; border-radius: 8px; padding: 6px 10px; cursor: pointer; }

.plats { display: grid; grid-template-columns: repeat(auto-fill, minmax(135px, 1fr)); gap: 10px; }
.plat {
  display: flex; align-items: center; gap: 10px; padding: 12px; cursor: pointer; user-select: none;
  border-radius: 12px; border: 2px solid rgba(255,255,255,.1); background: rgba(255,255,255,.04);
  text-transform: capitalize; font-size: 14px; transition: all .15s;
}
.plat:hover { background: rgba(255,255,255,.09); }
.plat.on { background: rgba(255,255,255,.1); }
.plat .tick { margin-left: auto; width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(255,255,255,.3); display: flex; align-items: center; justify-content: center; font-size: 11px; }
.plat.on .tick { background: #22c55e; border-color: #22c55e; color: #fff; }

.results .row { display: flex; gap: 10px; align-items: flex-start; padding: 11px 12px; border-radius: 10px; margin-top: 8px; font-size: 14px; }
.row.ok { background: rgba(34,197,94,.14); color: #86efac; }
.row.bad { background: rgba(239,68,68,.14); color: #fca5a5; }
.row.load { background: rgba(124,58,237,.16); color: #c4b5fd; }
.badge { font-weight: 800; flex-shrink: 0; }
