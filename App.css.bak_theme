.shell{
  --bg:#f3f5f9;--surface:#fff;--soft:#f6f8fc;--line:#e4e8f0;--text:#101828;--muted:#667085;
  --brand:#2f5bff;--brand-soft:#eaefff;--ok:#12a26b;--ok-soft:#e5f7ef;--bad:#e5484d;--bad-soft:#fdecec;
  --load:#6d4aff;--load-soft:#efeaff;--shadow:0 1px 2px rgba(16,24,40,.05),0 8px 24px rgba(16,24,40,.06);
  display:grid;grid-template-columns:232px 1fr;min-height:100vh;width:100%;
  background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
  font-size:14.5px;line-height:1.5;text-align:left;
}
.shell[data-theme=dark]{
  --bg:#0b0f1a;--surface:#131a2a;--soft:#0f1524;--line:#223048;--text:#eef2fb;--muted:#8e9bb5;
  --brand:#5b7dff;--brand-soft:#1a2750;--ok:#3ddc97;--ok-soft:#10301f;--bad:#ff7a7f;--bad-soft:#3a1618;
  --load:#a994ff;--load-soft:#241c4a;--shadow:0 8px 28px rgba(0,0,0,.35);
}
.shell *{box-sizing:border-box}
.shell h1,.shell h2,.shell p{margin:0}
.shell button,.shell input,.shell textarea{font:inherit;color:inherit}
.shell button{cursor:pointer}
.ic{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* sidebar */
aside{position:sticky;top:0;height:100vh;background:var(--surface);border-right:1px solid var(--line);padding:20px 14px;display:flex;flex-direction:column;gap:6px}
.brand{display:flex;align-items:center;gap:10px;padding:4px 10px 18px;font-weight:800;font-size:17px}
.mark{width:34px;height:34px;border-radius:10px;background:var(--brand);color:#fff;display:grid;place-items:center}
.nav{display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:none;color:var(--muted);font-weight:600;text-align:left;transition:.15s}
.nav:hover{background:var(--soft);color:var(--text)}
.nav.on{background:var(--brand-soft);color:var(--brand)}
.nav .b{margin-left:auto;font-size:12px;background:var(--soft);color:var(--muted);padding:1px 8px;border-radius:99px}
.nav.on .b{background:var(--surface);color:var(--brand)}
.side-foot{margin-top:auto;padding:12px;border-radius:12px;background:var(--soft);border:1px solid var(--line);font-size:13px;color:var(--muted)}
.side-foot b{display:block;color:var(--text)}

/* main */
main{min-width:0;padding:0 28px 40px}
.top{display:flex;align-items:center;gap:12px;padding:20px 0;position:sticky;top:0;background:var(--bg);z-index:5}
.top h1{font-size:22px;font-weight:800}
.top p{color:var(--muted);font-size:13.5px}
.sp{flex:1}
.icon-btn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;color:var(--muted)}
.icon-btn:hover{color:var(--text)}
.pill{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;padding:7px 12px;border-radius:99px;background:var(--ok-soft);color:var(--ok)}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.live{background:#fff0e6;color:#d9540b}
.shell[data-theme=dark] .pill.live{background:#3a1d0c;color:#ff9a5c}

.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,1fr);gap:22px;align-items:start}
.sticky{position:sticky;top:84px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:22px}
.card+.card{margin-top:18px}
.card h2{font-size:16px;font-weight:700}
.sub{color:var(--muted);font-size:13.5px;margin:2px 0 16px}
.muted{color:var(--muted);font-size:12.5px}
.stack>*+*{margin-top:18px}

.types{display:inline-flex;padding:4px;background:var(--soft);border:1px solid var(--line);border-radius:12px;gap:2px;margin-bottom:18px}
.types button{border:0;background:none;padding:8px 20px;border-radius:9px;font-weight:600;color:var(--muted)}
.types button.on{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(16,24,40,.15)}

.fl{display:flex;justify-content:space-between;align-items:baseline;font-weight:600;font-size:13.5px;margin-bottom:7px}
.fl span{font-weight:500;color:var(--muted);font-size:12.5px}
.fl em{font-style:normal;color:var(--bad);margin-left:2px}
.who{display:flex;align-items:center;gap:8px;text-transform:capitalize}
.in{display:block;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:11px;padding:11px 13px;outline:none;transition:.15s;resize:vertical;font-size:14.5px}
.in::placeholder{color:#98a2b3}
.in:focus{border-color:var(--brand);box-shadow:0 0 0 4px var(--brand-soft)}
textarea.in{min-height:120px}
textarea.in.sm{min-height:76px}

.drop{display:flex;align-items:center;gap:14px;padding:14px;border:1.5px dashed var(--line);border-radius:13px;background:var(--soft);cursor:pointer;transition:.15s}
.drop:hover{border-color:var(--brand);background:var(--brand-soft)}
.thumb{width:48px;height:48px;border-radius:11px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;flex:none}
.drop b{display:block;font-size:14px}
.drop small{color:var(--muted);font-size:12.5px;word-break:break-all}
.link{border:0;background:none;color:var(--bad);font-weight:600;font-size:13px;margin-left:auto;padding:6px 10px;border-radius:8px}
.link:hover{background:var(--bad-soft)}

.dot{width:26px;height:26px;border-radius:8px;display:inline-grid;place-items:center;font-weight:800;font-size:12px;color:#fff;text-transform:uppercase;flex:none}
.plats{display:flex;flex-wrap:wrap;gap:10px}
.plat{display:flex;align-items:center;gap:9px;padding:9px 14px 9px 10px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);font-weight:600;text-transform:capitalize;transition:.15s;user-select:none;cursor:pointer}
.plat:hover{border-color:var(--muted)}
.plat.on{border-color:var(--brand);background:var(--brand-soft)}
.tick{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;color:transparent}
.tick .ic{width:11px;height:11px;stroke-width:3}
.plat.on .tick{background:var(--brand);border-color:var(--brand);color:#fff}

.when{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.opt{display:flex;gap:11px;align-items:flex-start;padding:13px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);text-align:left;transition:.15s}
.rd{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--line);margin-top:2px;flex:none;display:grid;place-items:center}
.opt.on{border-color:var(--brand);background:var(--brand-soft)}
.opt.on .rd{border-color:var(--brand)}
.opt.on .rd::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--brand)}
.opt b{display:block;font-size:14px}
.opt small{color:var(--muted);font-size:12.5px}

.warn{margin-top:14px;padding:10px 14px;border-radius:10px;background:var(--bad-soft);border:1px solid var(--bad);color:var(--bad);font-size:13.5px}

.pv{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface)}
.pv-h{display:flex;align-items:center;gap:10px;padding:12px}
.av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--brand),#9b5bff);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px}
.pv-h b{display:block;font-size:13.5px;line-height:1.2}
.pv-h small{color:var(--muted);font-size:12px}
.pv-img{padding:26px 12px;text-align:center;background:var(--soft);color:var(--muted);font-size:13px;border-block:1px solid var(--line);word-break:break-all}
.pv-t{padding:12px;font-size:14px;white-space:pre-wrap;word-break:break-word;min-height:46px}
.pv-t.ph{color:#98a2b3}
.tags{display:flex;gap:6px;flex-wrap:wrap;padding:0 12px 12px}
.tag{font-size:12px;font-weight:600;padding:3px 9px;border-radius:99px;background:var(--soft);border:1px solid var(--line);color:var(--muted);text-transform:capitalize}

.tg{display:flex;align-items:center;gap:12px;margin-top:16px;padding:12px 14px;border-radius:12px;background:var(--soft);border:1px solid var(--line);cursor:pointer}
.tg input{display:none}
.sw{width:38px;height:22px;border-radius:99px;background:#c4cbd8;position:relative;transition:.2s;flex:none}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s}
.tg input:checked+.sw{background:var(--ok)}
.tg input:checked+.sw::after{left:19px}
.tg b{display:block;font-size:14px}
.tg small{color:var(--muted);font-size:12.5px}

.go{width:100%;margin-top:14px;border:0;border-radius:12px;background:var(--brand);color:#fff;font-weight:700;font-size:15.5px;padding:14px;box-shadow:0 6px 16px rgba(47,91,255,.3);transition:.15s;display:flex;align-items:center;justify-content:center;gap:9px}
.go:hover{filter:brightness(1.08)}
.go:disabled{opacity:.45;cursor:not-allowed;filter:none}

.row{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:10px;margin-top:10px;font-size:13.5px;font-weight:500}
.row.ok{background:var(--ok-soft);color:var(--ok)}
.row.bad{background:var(--bad-soft);color:var(--bad)}
.row.load{background:var(--load-soft);color:var(--load)}
.badge{font-weight:800;flex:none}
.login-msg{margin-top:12px;padding:10px 12px;border-radius:10px;background:var(--brand-soft);color:var(--brand);font-size:14px}

.item{display:flex;align-items:flex-start;gap:12px;padding:13px;border:1px solid var(--line);border-radius:12px;margin-top:10px;font-size:14px}
.item.bad{border-color:var(--bad);background:var(--bad-soft)}
.item .grow{flex:1;min-width:0}
.item small{display:block;margin-top:2px;word-break:break-word}
.err{color:var(--bad);font-size:12.5px}
.acts{display:flex;gap:6px;flex-wrap:wrap}
.mini{border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:6px 12px;font-size:13px;font-weight:600}
.mini:hover{background:var(--soft)}
.mini.del{color:var(--bad)}
.hrow{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}
.shell :focus-visible{outline:2px solid var(--brand);outline-offset:2px}

@media(max-width:1000px){.layout{grid-template-columns:1fr}.sticky{position:static}}
@media(max-width:760px){
  .shell{grid-template-columns:1fr}
  aside{position:fixed;inset:auto 0 0 0;height:auto;flex-direction:row;padding:6px 8px;z-index:20;border-right:0;border-top:1px solid var(--line);gap:2px}
  .brand,.side-foot,.nav .b{display:none}
  .nav{flex-direction:column;gap:2px;font-size:11.5px;padding:7px 4px;justify-content:center;text-align:center}
  main{padding:0 14px 96px}
  .top{padding:14px 0}
  .top h1{font-size:19px}
  .top p,.pill{display:none}
  .card{padding:16px}
  .when{grid-template-columns:1fr}
  .types{display:flex}
  .types button{flex:1;padding:8px 6px}
  .item{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){.shell *{transition:none!important}}

.kinds{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}
.kind{display:flex;align-items:center;gap:10px;padding:10px 16px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface);font-weight:600;color:var(--muted);transition:.15s}
.kind:hover{border-color:var(--muted)}
.kind.on{border-color:var(--brand);background:var(--brand-soft);color:var(--text)}
.cb{width:20px;height:20px;border-radius:6px;border:1.5px solid var(--line);display:grid;place-items:center;color:transparent}
.cb .ic{width:12px;height:12px;stroke-width:3}
.kind.on .cb{background:var(--brand);border-color:var(--brand);color:#fff}
.kindtag{font-size:12px;font-weight:700;padding:2px 10px;border-radius:99px;background:var(--soft);border:1px solid var(--line);color:var(--muted);text-transform:none}
.kindtag.post{background:var(--brand-soft);border-color:transparent;color:var(--brand)}
.kindtag.reel,.kindtag.story{background:var(--load-soft);border-color:transparent;color:var(--load)}
.kindtag.okt{background:var(--ok-soft);border-color:transparent;color:var(--ok)}
.kindtag.badt{background:var(--bad-soft);border-color:transparent;color:var(--bad)}
.item .who{flex-wrap:wrap}
.date{display:block;margin-top:4px;font-size:13px;font-weight:600;color:var(--text)}

.media{width:150px;height:100px;object-fit:cover;border-radius:10px;background:#000;flex:none;display:block}
.media-fb{display:grid;place-items:center;background:var(--soft);color:var(--muted);font-size:12px;padding:8px;text-align:center;word-break:break-all;overflow:hidden}
.pv-img.has{padding:0;display:grid;gap:2px}
.pv-img.has .media{width:100%;height:auto;max-height:260px;border-radius:0}
@media(max-width:760px){.item .media{width:100%;height:auto;max-height:220px}}

.item .acts{flex-direction:column;align-items:stretch}
.item .acts .mini{text-transform:capitalize;white-space:nowrap}
@media(max-width:760px){.item .acts{flex-direction:row}}

.prow{display:grid;grid-template-columns:150px 1fr;gap:12px;align-items:center}
@media(max-width:760px){.prow{grid-template-columns:1fr;gap:6px}}
/* ===== UI polish v3 (light touch) ===== */
html { scroll-behavior:smooth; }
@keyframes spFadeUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
@keyframes spPulse { 0%,100%{box-shadow:0 0 0 0 rgba(255,122,24,.4)} 50%{box-shadow:0 0 0 6px rgba(255,122,24,0)} }

section, .card, .panel { animation:spFadeUp .45s ease both; transition:box-shadow .3s ease; }

button { transition:transform .15s ease, box-shadow .2s ease, background .2s ease, filter .2s ease; cursor:pointer; }
button:hover:not(:disabled) { filter:brightness(1.06); }
button:active:not(:disabled) { transform:scale(.98); }
button:disabled { cursor:not-allowed; opacity:.55; }

.in, input, textarea, select { transition:border-color .2s ease, box-shadow .2s ease; }
.in:focus, input:focus, textarea:focus, select:focus { outline:none; border-color:#3366ff; box-shadow:0 0 0 3px rgba(51,102,255,.22); }

input[type="checkbox"], input[type="radio"] { accent-color:#3366ff; }
label { transition:background .2s ease, border-color .2s ease; }

::-webkit-scrollbar { width:10px; }
::-webkit-scrollbar-thumb { background:rgba(120,130,160,.35); border-radius:10px; border:2px solid transparent; background-clip:content-box; }

@media (prefers-reduced-motion:reduce) { * { animation:none !important; transition:none !important; } }
