{
  "name": "makhdoom-postpro",
  "productName": "Makhdoom PostPro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist": "vite build --base=./ && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.makhdoom.postpro",
    "productName": "Makhdoom PostPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    }
  },
  "description": "Makhdoom PostPro",
  "author": "Makhdoom Brothers"
}